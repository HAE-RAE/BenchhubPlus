FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies (HRET/tooling + ML runtime)
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    git \
    git-lfs \
    libgomp1 \
    libstdc++6 \
    libglib2.0-0 \
    libgl1 \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY pyproject.toml ./
COPY README.md ./

# Install Python dependencies. Set INSTALL_WORKER_EXTRAS=1 to also pull
# heavy local-inference deps (vllm, etc.) — only safe on linux/amd64 with
# CUDA. Default leaves them out so the image builds on ARM64 dev machines.
ARG INSTALL_WORKER_EXTRAS=0
RUN if [ "$INSTALL_WORKER_EXTRAS" = "1" ]; then \
      pip install --no-cache-dir -e ".[worker]"; \
    else \
      pip install --no-cache-dir -e .; \
    fi

# Optional: prefetch model weights for HRET (set build args to enable)
ARG HRET_PREFETCH_MODEL=""
ARG HRET_PREFETCH_REVISION=""
ENV HF_HOME=/app/.cache/huggingface \
    TRANSFORMERS_CACHE=/app/.cache/huggingface \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TOKENIZERS_PARALLELISM=false

RUN if [ -n "$HRET_PREFETCH_MODEL" ]; then \
    python -c "\
import os; \
from transformers import AutoModel, AutoTokenizer; \
model = os.environ.get('HRET_PREFETCH_MODEL'); \
revision = os.environ.get('HRET_PREFETCH_REVISION') or None; \
AutoTokenizer.from_pretrained(model, revision=revision) if model else None; \
AutoModel.from_pretrained(model, revision=revision) if model else None; \
"; fi

# Copy application code
COPY apps/ ./apps/
COPY logs/ ./logs/

# Create logs directory
RUN mkdir -p logs

# Health check for worker
HEALTHCHECK --interval=60s --timeout=30s --start-period=10s --retries=3 \
    CMD python -c "from apps.worker.celery_app import celery_app; celery_app.control.inspect().ping()" || exit 1

# Run Celery worker
CMD ["python", "-m", "celery", "-A", "apps.worker.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
