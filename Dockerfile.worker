FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies (HRET/tooling + ML runtime)
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    git \
    git-lfs \
    libgomp1 \
    libstdc++6 \
    libglib2.0-0 \
    libgl1 \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY pyproject.toml ./
COPY README.md ./

# Install CPU-only PyTorch first so the [worker] extras find it already
# satisfied. Without this, pip pulls the default CUDA wheel (~2 GB of
# nvidia-* libs) which blows the Railway image registry budget. Set
# INSTALL_GPU_EXTRAS=1 on a real GPU node to pull vllm + CUDA torch.
ARG INSTALL_GPU_EXTRAS=0
RUN if [ "$INSTALL_GPU_EXTRAS" = "1" ]; then \
      pip install --no-cache-dir -e ".[worker,gpu]"; \
    else \
      pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        --extra-index-url https://pypi.org/simple \
        torch && \
      pip install --no-cache-dir -e ".[worker]"; \
    fi

# Optional: prefetch model weights for HRET (set build args to enable)
ARG HRET_PREFETCH_MODEL=""
ARG HRET_PREFETCH_REVISION=""
ENV HF_HOME=/app/.cache/huggingface \
    TRANSFORMERS_CACHE=/app/.cache/huggingface \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TOKENIZERS_PARALLELISM=false

RUN if [ -n "$HRET_PREFETCH_MODEL" ]; then \
    python -c "\
import os; \
from transformers import AutoModel, AutoTokenizer; \
model = os.environ.get('HRET_PREFETCH_MODEL'); \
revision = os.environ.get('HRET_PREFETCH_REVISION') or None; \
AutoTokenizer.from_pretrained(model, revision=revision) if model else None; \
AutoModel.from_pretrained(model, revision=revision) if model else None; \
"; fi

# Copy application code
COPY apps/ ./apps/

# Create logs directory (we don't track an empty logs/ in git, so mkdir
# is the source of truth — keeps the image building on hosted CIs like
# Railway/Vercel that don't ship the directory).
RUN mkdir -p logs

# Health check for worker
HEALTHCHECK --interval=60s --timeout=30s --start-period=10s --retries=3 \
    CMD python -c "from apps.worker.celery_app import celery_app; celery_app.control.inspect().ping()" || exit 1

# Run Celery worker
CMD ["python", "-m", "celery", "-A", "apps.worker.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
