FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY pyproject.toml ./
COPY README.md ./

# Install Python dependencies
RUN pip install --no-cache-dir -e .

# 1. Parquet 시드 데이터를 위한 디렉토리 생성
RUN mkdir -p /app/data
# 2. 로컬의 Parquet 파일을 이미지로 복사
COPY seeds/seed_data.parquet /app/data/seed_data.parquet

# Copy application code
COPY apps/ ./apps/

# Create logs directory
RUN mkdir -p logs

# Expose default port (Railway / Fly etc. honour $PORT and may assign a
# different value at runtime; the CMD below falls back to 8000).
EXPOSE 8000

# Health check (uses $PORT so it lines up with whatever uvicorn is bound to)
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/api/v1/health || exit 1

# Run the application — bind to $PORT when the host PaaS assigns one
# (Railway, Fly, Render, Cloud Run all do), otherwise default to 8000.
CMD exec python -m uvicorn apps.backend.main:app --host 0.0.0.0 --port ${PORT:-8000}