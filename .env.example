# Database Configuration
DATABASE_URL=sqlite:///./benchhub_plus.db
# For self-hosted PostgreSQL:
#   postgresql://user:password@localhost:5432/benchhub_plus
# For Supabase (transaction pooler — recommended for runtime, port 6543):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# For Supabase (direct connection — migrations / CLI only, port 5432):
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# When pointing to the Supabase pooler the app auto-disables client-side
# pooling (NullPool) and forces sslmode=require — no extra flags needed.

# DB pool tuning (ignored on SQLite + Supabase pooler).
# Supabase Free tier: keep DB_POOL_SIZE + DB_MAX_OVERFLOW well below your plan
# direct-connection limit (free is ~60 across all clients).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis Configuration
# Local dev: redis://localhost:6379/0
# Prod (required): redis://:<password>@host:6379/0  (or rediss:// for TLS)
# The Celery startup check refuses to boot in production mode if the URL
# has no embedded password and is not using TLS / localhost.
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
DEV_AUTH_BYPASS=false

# LLM Configuration (for Planner Agent)
OPENAI_API_KEY=your_openai_api_key_here
PLANNER_MODEL=gpt-4
PLANNER_TEMPERATURE=0.1

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery Configuration — match REDIS_URL credentials
CELERY_BROKER_URL=redis://:change-me-redis-password@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:change-me-redis-password@localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# HRET Configuration
# TODO: Add HRET specific configuration when integrated
HRET_CONFIG_PATH=./config/hret_config.yaml
BENCHHUB_DATA_PATH=./data/benchhub
# Optional: prefetch a model at build time for worker images
HRET_PREFETCH_MODEL=
HRET_PREFETCH_REVISION=

# Cache Configuration
CACHE_TTL_SECONDS=3600
MAX_CACHE_SIZE=1000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8001/api/v1/auth/github/callback

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-please-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
